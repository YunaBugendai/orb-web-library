// Fetch and JSON: asynchronous HTTP, parsing the response, building DOM from it.
use web;

people: web.Element;

fn show_status(text: str) {
    web.set_text_by_id("status", text) catch |e| {};
}

fn render(j: web.Json) -> ! {
    n := try web.json_len(j);
    for i in 0..n {
        p := try web.json_at(j, i);
        nj := try web.json_get(p, "name");
        rj := try web.json_get(p, "role");
        name := try web.json_str(nj);
        role := try web.json_str(rj);
        li := try web.create("li");
        try web.set_text(li, name);
        sep := try web.create_text(" - ");
        em := try web.create("em");
        try web.set_text(em, role);
        try web.append(li, sep);
        try web.append(li, em);
        try web.append(people, li);
        web.free_str(name);
        web.free_str(role);
        web.release(sep);
        web.release(em);
        web.release(li);
        web.json_release(nj);
        web.json_release(rj);
        web.json_release(p);
    }
    return;
}

fn on_response(r: web.Response) {
    if web.failed(r) {
        show_status("Network error: the request could not be sent.");
        return;
    }
    if !web.response_ok(r) {
        show_status("The server answered with an error status.");
        return;
    }
    body := web.body_text(r) catch |e| { show_status("Could not read the response."); return; };
    j := web.json_parse(body) catch |e| { web.free_str(body); show_status("The response is not valid JSON."); return; };
    web.free_str(body);
    web.clear(people) catch |e| {};
    render(j) catch |e| { show_status("Unexpected JSON shape."); web.json_release(j); return; };
    web.json_release(j);
    show_status("Loaded.");
}

fn on_load() {
    show_status("Loading...");
    web.fetch_get("people.json", on_response) catch |e| { show_status("Could not start the request."); };
}

fn main() {
    people = web.get_element("people") catch |e| { return; };
    b := web.get_element("load") catch |e| { return; };
    web.on_click(b, on_load) catch |e| { return; };
}
