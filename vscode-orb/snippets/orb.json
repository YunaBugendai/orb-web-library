{
  "main": { "prefix": "main", "body": ["fn main() {", "\t$0", "}"], "description": "main function" },
  "fn": { "prefix": "fn", "body": ["fn ${1:name}(${2}) ${3:-> i64 }{", "\t$0", "}"], "description": "function" },
  "pubfn": { "prefix": "pubfn", "body": ["pub fn ${1:name}(${2}) ${3:-> i64 }{", "\t$0", "}"], "description": "public function" },
  "struct": { "prefix": "struct", "body": ["struct ${1:Name} {", "\t${2:field}: ${3:i64},", "}"], "description": "struct" },
  "enum": { "prefix": "enum", "body": ["enum ${1:Name} {", "\t${2:First},", "\t${3:Second},", "}"], "description": "enum" },
  "for": { "prefix": "for", "body": ["for ${1:i} in ${2:0}..${3:n} {", "\t$0", "}"], "description": "range loop" },
  "forin": { "prefix": "forin", "body": ["for ${1:x} in ${2:items} {", "\t$0", "}"], "description": "loop over array / slice / string" },
  "fori": { "prefix": "fori", "body": ["for ${1:i}, ${2:x} in ${3:items} {", "\t$0", "}"], "description": "loop with index" },
  "while": { "prefix": "while", "body": ["while ${1:cond} {", "\t$0", "}"], "description": "while loop" },
  "loop": { "prefix": "loop", "body": ["loop {", "\t$0", "}"], "description": "infinite loop" },
  "if": { "prefix": "if", "body": ["if ${1:cond} {", "\t$0", "}"], "description": "if" },
  "ife": { "prefix": "ife", "body": ["if ${1:cond} {", "\t$2", "} else {", "\t$0", "}"], "description": "if / else" },
  "println": { "prefix": "pl", "body": ["println(${1});"], "description": "println" },
  "catch": { "prefix": "catch", "body": ["${1:v} := ${2:call()} catch |${3:e}| {", "\tprintln(\"error: \", ${3:e});", "\treturn;", "};"], "description": "catch an error" },
  "try": { "prefix": "try", "body": ["${1:v} := try ${2:call()};"], "description": "propagate an error" },
  "error": { "prefix": "error", "body": ["error ${1:Failed};"], "description": "declare an error" },
  "use": { "prefix": "use", "body": ["use ${1:math};"], "description": "import a module" },
  "vec": { "prefix": "vec", "body": ["use vec;", "", "${1:v}: vec.Vec<${2:i64}>;"], "description": "growable array" }
}
