fn main() {
    best := 0;
    best_n := 0;
    n := 1;
    while n < 3000000 {
        x := n;
        steps := 0;
        while x != 1 {
            if x % 2 == 0 { x = x / 2; } else { x = 3 * x + 1; }
            steps += 1;
        }
        if steps > best { best = steps; best_n = n; }
        n += 1;
    }
    println(best_n, " ", best);
}
