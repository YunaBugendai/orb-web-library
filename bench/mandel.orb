fn main() {
    w := 600;
    h := 400;
    total := 0;
    for py in 0..h {
        for px in 0..w {
            cx := (px as f64) / (w as f64) * 3.5 - 2.5;
            cy := (py as f64) / (h as f64) * 2.0 - 1.0;
            x := 0.0;
            y := 0.0;
            it := 0;
            while it < 200 && x * x + y * y <= 4.0 {
                t := x * x - y * y + cx;
                y = 2.0 * x * y + cy;
                x = t;
                it += 1;
            }
            total += it;
        }
    }
    println(total);
}
