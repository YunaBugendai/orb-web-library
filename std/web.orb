// web - Orb! Web: browser integration for programs compiled with `orb build --target wasm`.
//
//   use web;
//
//   fn main() {
//       button := web.get_element("go") catch |e| { return; };
//       web.on_click(button, on_go) catch |e| { return; };
//   }
//   fn on_go() { web.set_text_by_id("out", "Hello from Orb!") catch |e| {}; }
//
// HTML and CSS stay in the page; this module only talks to the DOM and the browser through the small
// JavaScript runtime web/orb.js. Everything that can fail returns an error union (`T!` or `!`).
//
// Ownership rules
//   * `str` results of this module are heap-allocated: release them with `web.free_str(s)`.
//   * Element handles are reference counted by the runtime: asking for the same element twice gives the
//     same handle; call `web.release(el)` for every handle you no longer need (singletons may be kept).
//   * Event and Response handles are valid only inside the callback that receives them.
//   * Json handles are owned by you: call `web.json_release(j)` when done.
//
// Synchronous: everything except `fetch` and the timers. Asynchronous: `fetch`, `set_timeout`,
// `set_interval` and event callbacks - they return at once and call your `fn` later, on the browser's
// event loop, one callback at a time.

use vec;

pub error BadHandle, NotFound, Invalid, Security, WrongType, Network, Unsupported;

// ---------------------------------------------------------------- host imports (module "orb_web")
extern fn h_release(h: i32) -> i32 = "orb_web.release";
extern fn h_get_element(p: *u8, n: i32) -> i32 = "orb_web.get_element";
